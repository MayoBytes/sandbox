#!/usr/bin/env bash
#
# sandbox — run any agentic coding tool in a rootless podman container with no
#           route to the internet except through a domain-allowlist proxy.
#
#   ./sandbox claude              # sandbox $PWD, run claude
#   ./sandbox opencode ~/code/x   # sandbox a specific project
#   ./sandbox crush ~/code/x
#   ./sandbox shell ~/code/x      # bash, no agent — for poking at the boundary
#
#   ./sandbox --build             # (re)build images
#   ./sandbox --logs              # tail proxy log: every request, every denial
#   ./sandbox --down              # tear down proxy + networks
#   ./sandbox --agents            # list available profiles
#
# Adding an agent = drop a file in agents/ and (optionally) a file in
# proxy/allowlist.d/. Nothing below this line is agent-specific.
#
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
IMAGE="agent-sandbox:latest"
PROXY_IMAGE="agent-sandbox-proxy:latest"
INTERNAL_NET="agent-internal"   # --internal: NO egress. This is the boundary.
EGRESS_NET="agent-egress"
PROXY_NAME="agent-proxy"
STATE_ROOT="${XDG_DATA_HOME:-$HOME/.local/share}/agent-sandbox"
NOTIFY_ENABLED=0

log()  { printf '\033[1;34m==>\033[0m %s\n' "$*" >&2; }
warn() { printf '\033[1;33mwarn:\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31merror:\033[0m %s\n' "$*" >&2; exit 1; }

# ---------------------------------------------------------------------- host --
# The boundary itself is kernel work — netavark's --internal network, caps,
# cgroups, userns — so it is identical on macOS, where podman machine supplies a
# real Linux kernel in a VM. Only the thin layer of host-side shell differs.
# Every platform difference is resolved HERE. Nothing below this block branches
# on the OS again; if you find yourself adding a second `case $HOST`, add a shim
# up here instead.
case "$(uname -s)" in
  Darwin) HOST=darwin ;;
  Linux)  HOST=linux  ;;
  *) die "unsupported host: $(uname -s)" ;;
esac

if [[ $HOST == linux ]]; then
  # SELinux MCS relabelling. Vestigial on Arch already (see the notify mount),
  # but harmless and correct where SELinux does exist.
  Z=':Z'; ROZ=':ro,Z'
  # Runtime dir on purpose: tmpfs, 0700, wiped at logout — a channel out of the
  # box should not outlive the session that opened it.
  NOTIFY_DIR="${XDG_RUNTIME_DIR:-/tmp}/agent-sandbox/notify"
else
  # No SELinux to relabel for, and podman cannot chcon a virtiofs-backed path
  # inside the VM anyway — it errors or silently no-ops depending on version.
  Z=''; ROZ=':ro'
  # XDG_RUNTIME_DIR is unset on macOS, and the /tmp fallback would be neither
  # per-user nor 0700. $TMPDIR (/var/folders/…) is both. It is NOT tmpfs and
  # survives logout, so the "does not outlive the session" property is weaker
  # here — see README "Known gaps".
  NOTIFY_DIR="${TMPDIR:-/tmp}/agent-sandbox/notify"
fi

# No realpath on stock macOS, and macOS readlink has no -f. $project is
# -d-checked before this is called, so the subshell cd is exact for our one use
# — and it drops a coreutils dependency on Linux too.
sbx_realpath() { (cd "$1" && pwd -P); }

# No sha256sum on stock macOS. Both spellings emit "<hex>  -", so the truncated
# digest is byte-identical across platforms and existing state dirs keyed by it
# are not orphaned. Do not "simplify" this to openssl dgst — that prints a
# different format and would silently re-key every project's state.
sbx_sha256() {
  if command -v sha256sum >/dev/null 2>&1; then sha256sum; else shasum -a 256; fi
}

# ---------------------------------------------------------------- allowlist --
# Squid takes one dstdomain file, so concatenate allowlist.d/*.txt into it.
# Skips 99-* (docs). The union applies to all agents: adding an agent widens
# the allowlist for every agent. Accept that, or run a proxy per agent.
render_allowlist() {
  local out="$HERE/proxy/allowlist.generated.txt"
  {
    echo "# GENERATED from proxy/allowlist.d/ — do not edit."
    for f in "$HERE"/proxy/allowlist.d/*.txt; do
      [[ "$(basename "$f")" == 99-* ]] && continue
      printf '\n# --- %s ---\n' "$(basename "$f")"
      cat "$f"
    done
  } > "$out"
  local n
  n=$(grep -cvE '^\s*(#|$)' "$out" || true)
  log "allowlist: $n domains"
}

# ----------------------------------------------------------------- profiles --
list_agents() {
  for f in "$HERE"/agents/*.sh; do
    printf '  %s\n' "$(basename "$f" .sh)"
  done
}

load_agent() {
  local name="$1" f="$HERE/agents/$1.sh"
  [[ -f "$f" ]] || { echo "unknown agent: $name" >&2; echo "available:" >&2; list_agents >&2; exit 1; }
  AGENT_CMD=(); AGENT_STATE_DIRS=(); AGENT_STATE_FILES=(); AGENT_ENV=()
  unset -f agent_seed_project 2>/dev/null || true
  # shellcheck source=/dev/null
  source "$f"
  [[ ${#AGENT_CMD[@]} -gt 0 ]] || die "$name.sh defines no AGENT_CMD"
}

# --------------------------------------------------------------- vm (macOS) --
# On macOS every podman call is remote: the client talks to podman inside a Linux
# VM. Three of that arrangement's failure modes are silent or misleading, so
# check them once, up front, rather than debugging them through a confusing
# error later. No-op on Linux.
ensure_machine() {
  [[ $HOST == darwin ]] || return 0

  local state
  state="$(podman machine inspect --format '{{.State}}' 2>/dev/null || true)"
  [[ "$state" == running ]] \
    || die "podman machine is not running (state: ${state:-none}) — 'podman machine start'"

  # --memory 8g on the agent container is a cgroup limit inside the VM. Ask for
  # more than the VM has and the limit is a lie the kernel cannot honour: the
  # agent gets OOM-killed mid-session instead of being told no.
  local vm_mb
  vm_mb="$(podman machine inspect --format '{{.Resources.Memory}}' 2>/dev/null || true)"
  if [[ "$vm_mb" =~ ^[0-9]+$ ]]; then
    (( vm_mb >= 10240 )) \
      || die "podman machine has ${vm_mb}MiB but the agent asks for 8g — 'podman machine set --memory 12288'"
  else
    warn "could not read podman machine memory; ensure it exceeds 8g"
  fi
}

# A path outside the VM's virtiofs shares does not fail loudly — podman creates
# the mount point and it comes up EMPTY, so the agent runs against nothing and
# looks like it succeeded. Refuse instead.
#
# This asks the VM whether the path is there rather than reading the machine's
# share list, because that list is not exposed: `podman machine inspect` reports
# Mounts as null on podman 6 and the field is not even templatable. Testing the
# property beats parsing an internal config layout that can move between
# releases. One ssh round-trip, ~0.2s, both paths in a single call.
assert_vm_shared() {
  [[ $HOST == darwin ]] || return 0
  local p
  for p in "$@"; do
    # These are interpolated into a remote shell command. Paths this odd are not
    # worth supporting; refusing is cheaper than getting the quoting wrong.
    case $p in *"'"*) die "path contains a single quote, which this tool will not pass to the VM: $p" ;; esac
  done

  local cmd='' missing
  for p in "$@"; do cmd+="test -d '$p' || echo '$p'; "; done
  missing="$(podman machine ssh "$cmd" 2>/dev/null || true)"
  [[ -z "${missing//[[:space:]]/}" ]] && return 0

  die "not visible inside the podman machine VM, so it would mount EMPTY:
$(printf '%s\n' "$missing" | sed 's/^/    /')
  The VM only sees paths shared into it at init. Either move the project under a
  shared path, or re-create the machine:
    podman machine rm && podman machine init --cpus 6 --memory 12288 --disk-size 100 \\
      --volume \"\$HOME/git:\$HOME/git\" --volume \"$STATE_ROOT:$STATE_ROOT\""
}

# ------------------------------------------------------------------ podman ---
build() {
  ensure_machine
  render_allowlist
  log "building $PROXY_IMAGE"
  podman build -t "$PROXY_IMAGE" "$HERE/proxy"
  log "building $IMAGE"
  podman build -t "$IMAGE" "$HERE"
}

ensure_networks() {
  # --internal = no gateway, no NAT, no way out. Everything else is decoration.
  podman network exists "$INTERNAL_NET" \
    || { log "creating internal (no-egress) network"; podman network create --internal "$INTERNAL_NET" >/dev/null; }
  podman network exists "$EGRESS_NET" \
    || { log "creating egress network"; podman network create "$EGRESS_NET" >/dev/null; }
}

ensure_proxy() {
  render_allowlist
  if podman container exists "$PROXY_NAME"; then
    podman start "$PROXY_NAME" >/dev/null 2>&1 || true
    # allowlist is bind-mounted; HUP makes squid reread it without a restart
    podman kill -s HUP "$PROXY_NAME" >/dev/null 2>&1 || true
  else
    podman image exists "$PROXY_IMAGE" || die "run './sandbox --build' first"

    log "starting $PROXY_NAME"
    podman run -d --name "$PROXY_NAME" \
      --network "$EGRESS_NET" \
      --security-opt no-new-privileges \
      --cap-drop ALL --cap-add SETUID --cap-add SETGID \
      -v "$HERE/proxy/squid.conf:/etc/squid/squid.conf$ROZ" \
      -v "$HERE/proxy/allowlist.generated.txt:/etc/squid/allowlist.txt$ROZ" \
      "$PROXY_IMAGE" >/dev/null
    sleep 1
  fi

  # Dual-home it: reachable from the internal net, but it holds the only route
  # out. Must run whether the proxy was just created OR already existed — a
  # leftover proxy attached to egress only would otherwise never get wired to
  # the internal net, and agents on it can't even resolve "agent-proxy". Connect
  # is not idempotent (it errors if already attached), so guard on membership.
  if ! podman inspect -f '{{range $k,$_ := .NetworkSettings.Networks}}{{$k}} {{end}}' \
        "$PROXY_NAME" | grep -qw "$INTERNAL_NET"; then
    log "connecting $PROXY_NAME to $INTERNAL_NET"
    podman network connect "$INTERNAL_NET" "$PROXY_NAME"
  fi
}

# ---------------------------------------------------------------- notifier ---
# FIFOs are deliberately left in place between runs rather than swept: they are
# named per (agent, project) and the label is derived from that name, so a
# leftover can only ever be reused by the run it already describes. The cost of
# keeping one is a reader parked in open(2); the cost of deleting one is a
# recreated inode the listener won't notice (see run_agent). Bounded anyway —
# XDG_RUNTIME_DIR is tmpfs, and --down wipes it.
#
# Long-lived and shared, exactly like the proxy — deliberately NOT tied to this
# invocation. run_agent ends in exec, so there is no shell left to reap a
# per-run listener; and one that died on detach would leave a reattached
# container writing into a FIFO nobody reads, silently. Set SBX_NOTIFY=0 to
# opt out of the channel entirely.
ensure_notifier() {
  NOTIFY_ENABLED=0
  [[ "${SBX_NOTIFY:-1}" == 0 ]] && return 0

  # macOS: not ported, and it must say so rather than half-work. The FIFO cannot
  # cross virtiofs as a pipe, the listener needs bash 4 and flock (macOS has
  # neither), and an osascript renderer would reintroduce the string-injection
  # surface the argv-based one was built to avoid. Returning here also dodges a
  # nastier failure: setsid does not exist on macOS, so the `|| true` below would
  # swallow it and leave NOTIFY_ENABLED=1 — advertising a channel to the host
  # with no listener on the other end. See README "Known gaps".
  [[ $HOST == darwin ]] && return 0

  command -v notify-send >/dev/null 2>&1 \
    || { warn "no notify-send on host — notifications disabled"; return 0; }

  mkdir -p "$NOTIFY_DIR"; chmod 700 "$NOTIFY_DIR"
  # The listener flocks internally, so starting a second one is a no-op.
  setsid -f "$HERE/notify/listener" >>"$NOTIFY_DIR/listener.log" 2>&1 || true
  NOTIFY_ENABLED=1
}

# -------------------------------------------------------------------- run ----
run_agent() {
  local agent="$1" project="$2"
  [[ -d "$project" ]] || die "not a directory: $project"
  project="$(sbx_realpath "$project")"

  # Human-readable basename + a hash of the FULL realpath. The basename alone
  # collides (~/code/foo and ~/work/foo both -> "foo"), which would silently
  # share auth tokens and sessions between two unrelated projects — the exact
  # thing the per-project split is supposed to prevent. The hash disambiguates.
  local slug base hash
  base="$(basename "$project" | tr -cd '[:alnum:]._-')"
  hash="$(printf '%s' "$project" | sbx_sha256 | head -c 12)"
  slug="${base:-project}-$hash"

  # State is per (agent, project). Two agents don't share sessions or tokens,
  # and one project's compromised agent state can't touch another's.
  AGENT_STATE_ROOT="$STATE_ROOT/$agent/$slug"
  export AGENT_STATE_ROOT
  mkdir -p "$AGENT_STATE_ROOT"

  # Both of these are bind-mounted below, so both must be visible inside the VM.
  assert_vm_shared "$project" "$STATE_ROOT"

  local mounts=()
  for d in "${AGENT_STATE_DIRS[@]:-}"; do
    [[ -z "$d" ]] && continue
    mkdir -p "$AGENT_STATE_ROOT/$d"
    mounts+=(-v "$AGENT_STATE_ROOT/$d:/home/agent/$d$Z")
  done
  for f in "${AGENT_STATE_FILES[@]:-}"; do
    [[ -z "$f" ]] && continue
    mkdir -p "$(dirname "$AGENT_STATE_ROOT/$f")"
    [[ -f "$AGENT_STATE_ROOT/$f" ]] || echo '{}' > "$AGENT_STATE_ROOT/$f"
    mounts+=(-v "$AGENT_STATE_ROOT/$f:/home/agent/$f$Z")
  done

  local envs=()
  for e in "${AGENT_ENV[@]:-}"; do
    [[ -z "$e" ]] && continue
    envs+=(-e "$e")
  done

  # Protect the two execution-bearing paths in .git. Objects, refs, and index
  # stay writable so the agent can still commit — but it cannot drop a pre-push
  # hook or set core.sshCommand / a diff.*.textconv driver, any of which would
  # otherwise run on the HOST when you later review or push. .git/config is the
  # linchpin: read-only config means a committed .gitattributes has no driver to
  # invoke. Still review/push from a fresh clone — see README "The credential rule".
  local git_guard=()
  if [[ -d "$project/.git" ]]; then
    [[ -e "$project/.git/hooks" ]]  && git_guard+=(-v "$project/.git/hooks:/work/.git/hooks$ROZ")
    [[ -f "$project/.git/config" ]] && git_guard+=(-v "$project/.git/config:/work/.git/config$ROZ")
  fi

  # The notification channel: one FIFO, bind-mounted as a single file. This is
  # the only path from the box back to the host that isn't the proxy, so weigh
  # it as such — it IS an exfil channel, since the agent chooses the text and
  # you read it. What makes it an acceptable one: ~200 bytes per message,
  # rate-limited on the host, you are the only receiver, and it carries no
  # authority — the host renders it and is free to ignore it. No :Z; relabeling
  # a file in the host's runtime dir is not ours to do (and Arch has no SELinux).
  # The .label sidecar is never mounted, so attribution stays host-owned.
  local notify_mount=() fifo
  if (( NOTIFY_ENABLED )); then
    fifo="$NOTIFY_DIR/$agent-$slug.fifo"
    # Reuse, never recreate. rm+mkfifo would put a NEW inode at this path while
    # the listener's reader is still parked in open(2) on the old one: the
    # reader stays alive, so the listener (which tracks readers by path) never
    # spawns one for the new inode, and every run after the first goes to a
    # pipe nobody is holding. Same path, same inode, same reader.
    [[ -p $fifo ]] || { rm -f "$fifo"; mkfifo -m 600 "$fifo"; }
    printf '%s — %s\n' "$agent" "${base:-project}" > "$NOTIFY_DIR/$agent-$slug.label"
    notify_mount=(-v "$fifo:/run/sandbox-notify")
  fi

  if declare -F agent_seed_project >/dev/null; then
    agent_seed_project "$project"
  fi

  log "agent:   $agent"
  log "project: $project"
  log "network: $INTERNAL_NET (egress only via $PROXY_NAME)"
  (( NOTIFY_ENABLED )) && log "notify:  /run/sandbox-notify -> host desktop"

  # One array, expanded once, and never empty — because bash 3.2 (which is what
  # /bin/bash is on macOS) cannot expand an empty array to zero words under
  # set -u. "${arr[@]}" is an unbound-variable error there, and BOTH the usual
  # workarounds — "${arr[@]:-}" and "${arr[@]+"${arr[@]}"}" — yield one EMPTY
  # ARGUMENT rather than none, which podman then rejects. Appending only
  # non-empty arrays into an always-populated one sidesteps all of it. Keep the
  # append order: git_guard mounts are nested inside /work.
  local run=(run --rm -it
    --name "sbx-$agent-$slug-$$"
    --hostname sandbox
    --network "$INTERNAL_NET"
    --userns keep-id:uid=1000,gid=1000
    --security-opt no-new-privileges
    --cap-drop ALL
    --pids-limit 2048
    --memory 8g
    -e "HTTP_PROXY=http://${PROXY_NAME}:3128"
    -e "HTTPS_PROXY=http://${PROXY_NAME}:3128"
    -e "http_proxy=http://${PROXY_NAME}:3128"
    -e "https_proxy=http://${PROXY_NAME}:3128"
    -e "NO_PROXY=localhost,127.0.0.1"
    -e "GIT_AUTHOR_NAME=$agent (sandboxed)"
    -e "GIT_AUTHOR_EMAIL=$agent@sandbox.local"
    -e "GIT_COMMITTER_NAME=$agent (sandboxed)"
    -e "GIT_COMMITTER_EMAIL=$agent@sandbox.local"
  )
  if (( ${#envs[@]} ));         then run+=("${envs[@]}");         fi
  if (( ${#mounts[@]} ));       then run+=("${mounts[@]}");       fi
  run+=(-v "$project:/work$Z")
  if (( ${#git_guard[@]} ));    then run+=("${git_guard[@]}");    fi
  if (( ${#notify_mount[@]} )); then run+=("${notify_mount[@]}"); fi
  run+=(-w /work "$IMAGE" "${AGENT_CMD[@]}")

  exec podman "${run[@]}"
}

down() {
  podman rm -f "$PROXY_NAME" >/dev/null 2>&1 || true
  podman network rm -f "$INTERNAL_NET" "$EGRESS_NET" >/dev/null 2>&1 || true
  # The listener lives until here (or logout wipes the runtime dir), like the
  # proxy — it has no idle-timeout, so --down is its only planned exit. SIGTERM
  # to the leader; its TERM trap reaps the per-FIFO readers via the group kill.
  [[ -f "$NOTIFY_DIR/.listener.pid" ]] \
    && kill "$(cat "$NOTIFY_DIR/.listener.pid")" 2>/dev/null || true
  rm -rf "$NOTIFY_DIR"
  log "torn down"
}

# ------------------------------------------------------------------- main ----
case "${1:-}" in
  ""|-h|--help) sed -n '2,18p' "${BASH_SOURCE[0]}" | sed -E 's/^# ?//'; exit 0 ;;
  --build)  build; exit 0 ;;
  --down)   down;  exit 0 ;;
  --agents) list_agents; exit 0 ;;
  --logs)   exec podman logs -f "$PROXY_NAME" ;;
  shell)
    ensure_machine; ensure_networks; ensure_proxy; ensure_notifier
    AGENT_CMD=(/bin/bash); AGENT_STATE_DIRS=(); AGENT_STATE_FILES=(); AGENT_ENV=()
    run_agent shell "${2:-$PWD}"
    ;;
  *)
    load_agent "$1"
    ensure_machine; ensure_networks; ensure_proxy; ensure_notifier
    run_agent "$1" "${2:-$PWD}"
    ;;
esac
